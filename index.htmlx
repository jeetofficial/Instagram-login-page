<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dark Login UI</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#121212;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:white;
}

.container{
width:90%;
max-width:360px;
text-align:center;
}

.back{
font-size:30px;
text-align:left;
margin-bottom:30px;
cursor:pointer;
}

select{
background:none;
border:none;
color:#aaa;
font-size:17px;
margin-bottom:35px;
outline:none;
}

.logo-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 35px;
}

input{
width:100%;
padding:18px;
margin:10px 0;
background:#1f1f1f;
border:1px solid #444;
border-radius:15px;
font-size:16px;
color:white;
outline:none;
}

input::placeholder{
color:#888;
}

button{
width:100%;
padding:16px;
margin-top:15px;
border:none;
border-radius:30px;
background:#0d6efd;
color:white;
font-size:20px;
cursor:pointer;
transition:.3s;
}

button:hover{
transform:scale(.98);
}

.forgot{
display:block;
margin-top:25px;
text-decoration:none;
color:white;
font-size:17px;
}

.create{
margin-top:120px;
width:100%;
padding:16px;
border-radius:30px;
background:none;
border:2px solid #0d6efd;
color:#0d6efd;
font-size:18px;
}

.footer{
margin-top:30px;
color:#bbb;
font-size:24px;
}
</style>

</head>
<body>

<div class="container">

  <div class="back">←</div>

  <select>
    <option>English (UK)</option>
    <option>English (US)</option>
    <option>Hindi</option>
  </select>

  <!-- Official Style Instagram Logo -->
  <div class="logo-wrap">
    <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 100 100">
      <defs>
        <radialGradient id="ig-grad" cx="30%" cy="100%" r="130%">
          <stop offset="0%"   stop-color="#ffd600"/>
          <stop offset="20%"  stop-color="#ff7a00"/>
          <stop offset="45%"  stop-color="#ff0069"/>
          <stop offset="70%"  stop-color="#d300c4"/>
          <stop offset="100%" stop-color="#7638fa"/>
        </radialGradient>
      </defs>

      <!-- Background -->
      <rect width="100" height="100" rx="28" ry="28" fill="url(#ig-grad)"/>

      <!-- Camera body -->
      <rect x="20" y="20" width="60" height="60" rx="17" ry="17"
            fill="none" stroke="white" stroke-width="6"/>

      <!-- Lens -->
      <circle cx="50" cy="51" r="15"
              fill="none" stroke="white" stroke-width="6"/>

      <!-- Flash dot — camera body ke andar top-right -->
      <circle cx="68" cy="32" r="4.5" fill="white"/>

    </svg>
  </div>

  <input type="text" placeholder="Username or Email">

  <input type="password" placeholder="Password">

  <button>Log in</button>

  <a href="#" class="forgot">Forgot password?</a>

  <button class="create">Create new account</button>

  <div class="footer">∞ Meta</div>

</div>

</body>
</html>
>
